# Default Azure AD App Configuration
# These are fallback credentials when users don't configure their own Azure AD app
# For production deployment, register your own Azure AD app and update these values

# Your Azure AD Application (client) ID
VITE_DEFAULT_CLIENT_ID=your-client-id-here

# Your Azure AD Directory (tenant) ID
VITE_DEFAULT_TENANT_ID=your-tenant-id-here

# Redirect URI (update for production deployment)
VITE_REDIRECT_URI=http://localhost:5173
